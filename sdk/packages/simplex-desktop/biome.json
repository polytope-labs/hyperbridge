{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"files": {
		"ignore": ["./dist/*", "./resources/*"]
	},
	"formatter": { "enabled": false },
	"organizeImports": { "enabled": false },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": false,
			"correctness": { "noUnusedImports": "error" },
			"suspicious": { "noFocusedTests": "error" }
		}
	}
}
