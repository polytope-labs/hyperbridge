{
	"name": "@hyperbridge/simplex-desktop",
	"version": "0.16.2",
	"private": true,
	"type": "module",
	"main": "dist/main.js",
	"scripts": {
		"build": "pnpm run check:versions && tsup",
		"check:versions": "node scripts/verify-versions.mjs",
		"dev": "pnpm run build && electron .",
		"stage:node": "node scripts/stage-node.mjs",
		"test": "pnpm run test:unit && pnpm run test:integration",
		"test:e2e": "node scripts/e2e/assert-artifacts.mjs && tsx --tsconfig ../simplex/tsconfig.json --test --test-timeout=300000 scripts/e2e/desktop.e2e.mjs",
		"test:unit": "vitest --watch=false src/tests/desktop-paths.test.ts src/tests/daemon.test.ts src/tests/desktop-security.test.ts src/tests/electron-launch.test.ts src/tests/login-item.test.ts src/tests/solver-supervisor.test.ts src/tests/tray-icon.test.ts src/tests/tray-menu.test.ts scripts/stage-node.test.ts",
		"test:integration": "vitest --watch=false src/tests/protocol.test.ts",
		"lint": "biome lint src scripts",
		"format": "prettier --write \"{src,scripts}/**/*.{ts,mjs}\"",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@hyperbridge/simplex": "workspace:*"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@types/node": "^22.13.5",
		"electron": "44.3.0",
		"openpgp": "^6.2.2",
		"playwright-core": "1.63.0",
		"tar": "7.5.13",
		"tsx": "4.21.0",
		"tsup": "^8.4.0",
		"typescript": "5.7.3",
		"vitest": "^3.0.7"
	}
}
